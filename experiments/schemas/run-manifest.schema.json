{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reality404studio.dev/3d-world-compiler/experiment-run-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "protocol_version",
    "condition",
    "asset_id",
    "reference_sha256",
    "common_prompt_sha256",
    "condition_prompt_sha256",
    "model_id",
    "request_config",
    "started_at",
    "latency_ms",
    "usage",
    "api_transport_retries",
    "model_repairs",
    "subject_exit_status",
    "validation_status",
    "evaluator_status",
    "environment_commit",
    "environment_manifest_sha256",
    "evaluator_image_digest"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "protocol_version": { "const": "experiment-protocol-v1" },
    "condition": { "enum": ["C0", "C1", "C2", "C3"] },
    "asset_id": { "type": "string", "minLength": 1 },
    "reference_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "common_prompt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "condition_prompt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model_id": { "const": "gemini-3.7-flash" },
    "request_config": { "type": "object" },
    "started_at": { "type": "string" },
    "latency_ms": { "type": "number", "minimum": 0 },
    "usage": { "type": ["object", "null"] },
    "api_transport_retries": { "type": "integer", "minimum": 0 },
    "model_repairs": { "type": "integer", "minimum": 0 },
    "subject_exit_status": { "type": "string" },
    "validation_status": { "type": "string" },
    "evaluator_status": { "type": "string" },
    "failure_code": { "type": ["string", "null"] },
    "environment_commit": { "const": "91501a2e90d5d550acff01c3255f72c650ba1c03" },
    "environment_manifest_sha256": { "const": "315d5a625e53c0cd9f01d63eba6f206ffd349f74ebf824d14634de7d9c2428f9" },
    "evaluator_image_digest": { "const": "ghcr.io/reality404studio/3d-world-compiler-evaluator@sha256:e5ec14d963e7e4b84d76af0c64de36e3841354033b92623a27e340d74fd0177f" }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reality404studio.dev/3d-world-compiler/assembly.schema.json",
  "title": "3D World Compiler assembly v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "parts"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "1.0" },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/basePart" },
          { "$ref": "#/$defs/mirroredPart" }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "basePart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "primitive",
        "parent",
        "position",
        "rotation",
        "scale",
        "material"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "primitive": { "type": "string", "minLength": 1 },
        "parent": {
          "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/vec3" },
        "scale": { "$ref": "#/$defs/vec3" },
        "material": { "type": "string", "minLength": 1 }
      }
    },
    "mirroredPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mirrorOf", "axis"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "mirrorOf": { "$ref": "#/$defs/id" },
        "axis": { "enum": ["x", "y", "z"] }
      }
    }
  }
}

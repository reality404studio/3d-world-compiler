{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reality404studio.dev/3d-world-compiler/world.schema.json",
  "title": "3D World Compiler world v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "allowedPrimitives",
    "allowedMaterials",
    "maxParts",
    "transformBounds",
    "rotationQuantizationDegrees",
    "maxTriangles",
    "primitiveTriangleCosts",
    "structuralRules"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "world-v0" },
    "allowedPrimitives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["sphere", "ellipsoid", "capsule", "cone", "frustum", "box", "wedge", "tube"]
      }
    },
    "allowedMaterials": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,31}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["color", "roughness", "metalness"],
        "properties": {
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
          "metalness": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "maxParts": { "type": "integer", "minimum": 1, "maximum": 24 },
    "transformBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotation", "scale"],
      "properties": {
        "position": { "$ref": "#/$defs/bounds" },
        "rotation": { "$ref": "#/$defs/bounds" },
        "scale": { "$ref": "#/$defs/bounds" }
      }
    },
    "rotationQuantizationDegrees": { "type": "number", "exclusiveMinimum": 0, "maximum": 180 },
    "maxTriangles": { "type": "integer", "minimum": 1 },
    "primitiveTriangleCosts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sphere", "ellipsoid", "capsule", "cone", "frustum", "box", "wedge", "tube"],
      "properties": {
        "sphere": { "$ref": "#/$defs/triangleCost" },
        "ellipsoid": { "$ref": "#/$defs/triangleCost" },
        "capsule": { "$ref": "#/$defs/triangleCost" },
        "cone": { "$ref": "#/$defs/triangleCost" },
        "frustum": { "$ref": "#/$defs/triangleCost" },
        "box": { "$ref": "#/$defs/triangleCost" },
        "wedge": { "$ref": "#/$defs/triangleCost" },
        "tube": { "$ref": "#/$defs/triangleCost" }
      }
    },
    "structuralRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredRootCount", "mirrorSourceMustBeExplicit"],
      "properties": {
        "requiredRootCount": { "const": 1 },
        "mirrorSourceMustBeExplicit": { "const": true }
      }
    }
  },
  "$defs": {
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "triangleCost": { "type": "integer", "minimum": 1 }
  }
}

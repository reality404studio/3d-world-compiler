{
  "$schema": "../protocol/world.schema.json",
  "version": "world-v0",
  "allowedPrimitives": [
    "sphere",
    "ellipsoid",
    "capsule",
    "cone",
    "frustum",
    "box",
    "wedge",
    "tube"
  ],
  "allowedMaterials": {
    "clay": { "color": "#c9c2b5", "roughness": 0.82, "metalness": 0.0 },
    "slate": { "color": "#5d6872", "roughness": 0.76, "metalness": 0.0 },
    "sand": { "color": "#c8ab78", "roughness": 0.88, "metalness": 0.0 },
    "teal": { "color": "#4f8581", "roughness": 0.72, "metalness": 0.0 },
    "coral": { "color": "#b96f61", "roughness": 0.78, "metalness": 0.0 }
  },
  "maxParts": 24,
  "transformBounds": {
    "position": { "min": -4, "max": 4 },
    "rotation": { "min": -180, "max": 180 },
    "scale": { "min": 0.1, "max": 3 }
  },
  "rotationQuantizationDegrees": 15,
  "maxTriangles": 5000,
  "primitiveTriangleCosts": {
    "sphere": 224,
    "ellipsoid": 224,
    "capsule": 312,
    "cone": 32,
    "frustum": 64,
    "box": 12,
    "wedge": 8,
    "tube": 48
  },
  "structuralRules": {
    "requireAtLeastOneRoot": true,
    "mirrorSourceMustBeExplicit": true
  }
}
